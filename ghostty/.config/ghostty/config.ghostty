# Can be Vesper, Felxoki Dark, ...
theme = Synthwave 
font-family = JetBrainsMono Nerd Font Mono
font-size = 13

background-opacity = 0.80
background-blur = false

gtk-titlebar = false

window-padding-x = 10 
window-padding-y = 10 

cursor-color = #00FF00
cursor-text = #272822

selection-background = #CBA6F7
selection-foreground = #1E1E2E

